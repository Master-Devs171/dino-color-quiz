{
  "$schema":"https://json-schema.org/draft/2020-12/schema",
  "$id":"https://rjcferreira.github.io/dino-color-quiz/games/game.schema.json",
  "title":"DinoPlay Game Manifest",
  "type":"object",
  "additionalProperties":false,
  "required":["id","name","version","runtime","entry","category","age","cover","description","size","multiplayer","offline","assets"],
  "properties":{
    "id":{"type":"string","pattern":"^[a-z][a-z0-9-]{2,31}$"},
    "name":{"type":"string","minLength":2,"maxLength":50},
    "version":{"type":"string","pattern":"^\\d+\\.\\d+\\.\\d+$"},
    "runtime":{"enum":["native","sandbox"]},
    "entry":{"type":"string","minLength":1,"maxLength":160},
    "category":{"enum":["learn","puzzle","create","explore","action","sports","music"]},
    "age":{"type":"string","pattern":"^[3-9][+]$"},
    "cover":{"type":"string","pattern":"^(?!https?:|//).+"},
    "description":{"type":"string","minLength":10,"maxLength":180},
    "size":{"type":"string","pattern":"^\\d+(?:\\.\\d+)? (?:KB|MB)$"},
    "multiplayer":{"type":"boolean"},
    "offline":{"const":true},
    "assets":{"type":"array","minItems":1,"uniqueItems":true,"items":{"type":"string","pattern":"^(?!https?:|//).+"}},
    "permissions":{"type":"array","uniqueItems":true,"items":{"enum":["storage","multiplayer","entitlements"]},"default":[]},
    "extras":{"type":"array","maxItems":12,"uniqueItems":true,"items":{"type":"object","additionalProperties":false,"required":["id","name","description","type"],"properties":{"id":{"type":"string","pattern":"^[a-z][a-z0-9-]{2,31}$"},"name":{"type":"string","minLength":2,"maxLength":50},"description":{"type":"string","minLength":10,"maxLength":140},"type":{"const":"permanent"}}}},
    "author":{"type":"string","minLength":2,"maxLength":50},
    "license":{"type":"string","minLength":2,"maxLength":30}
  }
}
