{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "dinoplay-multiplayer",
  "main": "src/index.js",
  "compatibility_date": "2026-10-19",
  "durable_objects": {
    "bindings": [
      { "name": "ROOMS", "class_name": "GameRoom" }
    ]
  },
  "migrations": [
    { "tag": "v1", "new_sqlite_classes": ["GameRoom"] }
  ],
  "observability": { "enabled": true }
}
